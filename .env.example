# sub2api root URL, without /api/v1 suffix.
SUB2API_URL=
# Optional public browser origin when SUB2API_URL uses internal service DNS.
SUB2API_PUBLIC_URL=
SUB2API_ADMIN_KEY=
# Optional native row enhancements for the HTML-only pilot (default off).
HELPER_NATIVE_UI=false
# Temporary aliases for upgrading a separate Helper host. Keep off on a shared origin.
HELPER_LEGACY_ROUTES=false
# Optional automation credential; native buttons authenticate the logged-in admin.
HELPER_ADMIN_TOKEN=
# Browser-accessible origin for menu links (no /_helper suffix).
HELPER_PUBLIC_URL=
HELPER_DB_PATH=/data/helper.db
TZ=Asia/Shanghai
# Optional: required only for manual mail and automated inactivity rules.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
