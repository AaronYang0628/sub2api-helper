# sub2api root URL, without /api/v1 suffix.
SUB2API_URL=
# Optional public browser origin when SUB2API_URL uses internal service DNS.
SUB2API_PUBLIC_URL=
SUB2API_ADMIN_KEY=
# Native row buttons through the same-origin web proxy (default true).
HELPER_NATIVE_UI=true
# Optional automation credential; native buttons authenticate the logged-in admin.
HELPER_ADMIN_TOKEN=
# Browser-accessible origin (the original sub2api URL when using the native proxy).
HELPER_PUBLIC_URL=
HELPER_DB_PATH=/data/helper.db
TZ=Asia/Shanghai
# Optional: required only for manual mail and automated inactivity rules.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls
